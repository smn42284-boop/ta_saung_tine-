# Server-side settings. Never expose the Cosmos key using a VITE_ variable.
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-primary-key
COSMOS_DATABASE=makeawish-db
COSMOS_CONTAINER=wishes
ADMIN_PIN=2026

# Public browser-demo PIN only; VITE_ variables are included in browser bundles.
# Real Azure Functions authentication always uses server-side ADMIN_PIN.
VITE_ADMIN_PIN=2026
